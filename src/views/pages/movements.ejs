<%- include("../partials/head") %> <%- include('../partials/header') %>
<main id="main-content" class="min-h-screen bg-base-200 py-8">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- En-tête de la page -->
    <header class="mb-8">
      <h1 class="text-4xl md:text-5xl font-bold text-secondary mb-4">
        Les courants picturaux
      </h1>

      <!-- Indication du nombre total de courants -->
      <p class="text-lg text-base-content/80" role="status" aria-live="polite">
        <%= movements.length %> <%= movements.length > 1 ? 'courants picturaux'
        : 'courant pictural' %> dans la collection
      </p>
    </header>

    <!-- Liste des courants picturaux -->
    <% if (movements.length > 0) { %>
    <ul class="space-y-4" role="list">
      <% movements.forEach((movement, index) => { %>
      <li>
        <article
          class="collapse collapse-arrow bg-base-100 shadow-lg hover:shadow-xl transition-shadow duration-300"
          aria-labelledby="movement-title-<%= index %>"
        >
          <input
            type="radio"
            name="movements-accordion"
            id="movement-<%= index %>"
          />

          <!-- En-tête du collapse (titre visible) -->
          <div class="collapse-title">
            <h2
              class="text-xl md:text-2xl font-bold text-primary"
              id="movement-title-<%= index %>"
            >
              <%= movement.name %>
            </h2>
          </div>

          <!-- Contenu dépliable -->
          <div class="collapse-content">
            <div class="pt-4 border-t border-base-300">
              <h3 class="sr-only">Description du courant</h3>
              <p class="text-base leading-relaxed text-base-content/90 mb-4">
                <%= movement.description %>
              </p>

              <!-- Lien vers les tableaux du courant (optionnel) -->
              <div class="flex justify-end mt-4">
                <a href="/paintings?movement=<%= movement.id %>">
                  <button
                    class="btn btn-sm btn-secondary"
                    aria-label="Voir les tableaux du courant <%= movement.name %>"
                    id="movement-click"
                  >
                    Voir les tableaux
                    <span aria-hidden="true">→</span>
                  </button>
                </a>
              </div>
            </div>
          </div>
        </article>
      </li>
      <% }) %>
    </ul>
    <% } else { %>
    <!-- Message si aucun courant -->
    <div class="alert alert-info shadow-lg" role="status">
      <span
        >Aucun courant pictural n'est actuellement disponible dans la
        collection.</span
      >
    </div>
    <% } %>

    <!-- Navigation -->
    <nav aria-label="Navigation" class="mt-8 flex justify-between items-center">
      <a href="/paintings">
        <button class="btn btn-outline btn-accent">
          <span aria-hidden="true">←</span>
          Retour aux tableaux
        </button>
      </a>

      <a href="/">
        <button class="btn btn-ghost">Retour à l'accueil</button>
      </a>
    </nav>
  </div>
</main>
<%- include('../partials/footer') %>
