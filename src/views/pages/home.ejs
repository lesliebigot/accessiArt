<%- include("../partials/head") %> <%- include('../partials/header') %>

<!-- corps de la page d'accueil -->
<main id="main-content">
  <section class="hero bg-base-200 min-h-screen" aria-labelledby="hero-title">
    <!-- l'attribut aria-labelledby indique qu'il existe quelque part un élément (h1) avec id="hero-title" qui sert de titre/label à cette section. -->
    <div class="hero-content flex-col lg:flex-row-reverse">
      <a href="/paintings" 
        class="block w-full max-w-sm lg:max-w-md mb-8 lg:mb-0"
        aria-label="Découvrir la collection de tableaux impressionnistes">
        <img
          src="/images/Claude_Monet,_Impression,_soleil_levant.webp"
          alt="Impression, soleil levant de Claude Monet - Peinture impressionniste représentant un port au lever du soleil avec des bateaux dans une brume orangée"
          class="w-full max-w-sm rounded-lg shadow-2xl mb-8 lg:mb-0 lg:max-w-md"
          loading="lazy"
        />
      </a>
      <!-- Le lazy loading permet de prioriser le chargement du contenu textuel -->
      <div>
        <h1 id="hero-title" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-primary leading-tight">
          Accessi'Art : Peinture en Mots
        </h1>
        <p class="py-6 text-lg leading-relaxed">
          Accessi'Art rend l'art accessible à tous grâce à des descriptions
          détaillées et immersives des chefs-d'œuvre de la peinture. Explorez
          les tableaux impressionnistes, classiques et modernes à travers des
          mots qui donnent vie aux couleurs, aux formes et aux émotions. Que
          vous soyez malvoyant ou simplement passionné d'art, plongez dans
          l'univers des grands maîtres et enrichissez votre culture artistique.
        </p>
        <a href="/paintings">
          <button
            class="btn btn-secondary btn-xl"
            aria-label="En savoir plus sur Accessi'Art et découvrez les tableaux"
          >
            Découvrir
          </button>
        </a>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
