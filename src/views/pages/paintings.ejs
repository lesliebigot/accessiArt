<%- include("../partials/head") %> <%- include('../partials/header') %>
<main id="main-content">
  <div class="container mx-auto p-4">
    <!-- Titre principal de la page pour les lecteurs d'écran uniquement avec la classe sr-only -->
    <h1 class="sr-only">Collection de tableaux impressionnistes</h1>

    <!-- Section filtre -->
    <div
      class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4"
    >
      <!-- Indication du nombre total de tableaux -->
      <p class="text-lg" role="status" aria-live="polite">
        <%= paintings.length %> <%= paintings.length > 1 ? 'tableaux' :
        'tableau' %> dans la collection
      </p>

      <!-- Filtre par mouvement -->
      <div class="form-control w-full md:w-auto md:min-w-[300px]">
        <label for="movement-dropdown" class="label">
          <span class="label-text font-semibold"
            >Filtrer par courant pictural</span
          >
        </label>
        <select
          id="movement-dropdown"
          name="movement"
          class="select select-bordered w-full"
          aria-label="Filtrer les tableaux par courant pictural"
        >
          <option value="*" selected>Tous les courants</option>
          <% movements.forEach((movement) => { %>
          <option value="<%= movement.id %>"><%= movement.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Liste des tableaux -->
    <ul
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"
      role="list"
      id="paintings-list"
    >
      <% paintings.forEach((painting) => { %>
      <li data-movement-id="<%= painting.movement_id %>">
        <article
          class="card bg-base-100 shadow-sm h-full flex flex-col"
          aria-labelledby="painting-title-<%= painting.id %>"
        >
          <figure class="h-80 flex-shrink-0">
            <img
              src="<%= painting.image_url %>"
              alt="<%= painting.short_description || painting.title + ' par ' + painting.painter %>"
              class="w-full h-full object-cover rounded-lg shadow-2xl"
              loading="lazy"
            />
          </figure>
          <div class="card-body flex flex-col flex-grow">
            <h2 class="card-title" id="painting-title-<%= painting.id %>">
              <%= painting.title %>
            </h2>
            <p class="text-base-content/70">
              <span class="sr-only">Artiste : </span>
              <%= painting.painter %>
            </p>
            <p class="text-sm text-primary/70">
              <span class="sr-only">Courant : </span>
              <%= painting.movement_name %>
            </p>
            <!-- Espaceur flexible qui pousse le bouton vers le bas -->
            <div class="flex-grow"></div>
            <div class="card-actions justify-end mt-4">
              <a
                href="/painting/<%= painting.id %>"
                class="btn btn-secondary"
                aria-label="En savoir plus sur <%= painting.title %> de <%= painting.painter %>"
              >
                En savoir plus
              </a>
            </div>
          </div>
        </article>
      </li>
      <% }) %>
    </ul>

    <!-- Message si aucun résultat après filtrage -->
    <div
      id="no-results-message"
      class="text-center mt-8"
      style="display: none"
      role="status"
    >
      <div class="alert alert-warning shadow-lg inline-flex">
        <span
          >Aucun tableau ne correspond à ce courant pictural pour
          l'instant.</span
        >
      </div>
    </div>

    <!-- Message si aucun tableau en base de données -->
    <% if (paintings.length === 0) { %>
    <p class="text-center text-lg mt-8" role="status">
      Aucun tableau n'est actuellement disponible dans la collection.
    </p>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
