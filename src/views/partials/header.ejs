<body data-theme="night">
  <!-- Skip link pour navigation au clavier -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-0 focus:left-0 focus:z-50 focus:p-4 focus:bg-primary focus:text-primary-content"
  >
    Aller au contenu principal
  </a>
  <!-- Menu de navigation -->
  <header role="banner">
    <nav
      class="navbar bg-base-200 shadow-sm"
      role="navigation"
      aria-label="Navigation principale"
    >
      <div class="flex-1">
        <a
          href="/"
          class="btn btn-ghost text-xl text-primary"
          aria-label="Accessi'Art - Retour à l'accueil"
        >
          Accessi'Art
        </a>
      </div>
      <div class="flex-none">
        <ul class="menu menu-horizontal px-0 sm:px-1 text-xs sm:text-base" role="menubar">
          <li role="none">
            <a
              href="/paintings"
              role="menuitem"
              aria-label="Découvrir les tableaux"
              class="px-2 sm:px-4"
            >
              Les tableaux
            </a>
          </li>
          <li role="none">
            <a
              href="/movements"
              role="menuitem"
              aria-label="Découvrir les courants picturaux"
              class="px-2 sm:px-4"
            >
              Les courants picturaux
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </header>

